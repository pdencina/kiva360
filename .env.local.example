# ─────────────────────────────────────────────────
# KIVA360 — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# NUNCA subas .env.local a GitHub
# ─────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kiva360

# ── Email — Resend ────────────────────────────────
# Crear cuenta en resend.com (gratis hasta 3.000 emails/mes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@kiva360.cl

# ── SMS — Twilio ──────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+569XXXXXXXX

# ── Pagos — Transbank WebPay ──────────────────────
# Usar código de integración en desarrollo
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENV=integration
